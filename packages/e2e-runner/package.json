{
  "name": "@jittle-lamp/e2e-runner",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "description": "jl-e2e CLI and jl-e2e-runner daemon: transcript-driven AI E2E runs on Tester Army e2e",
  "bin": {
    "jl-e2e": "./dist/cli.js",
    "jl-e2e-runner": "./dist/daemon.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/providers.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "bun build --target node --outdir dist --entry-naming [name].js --external e2e --external @e2e-dev/web --external playwright --external playwright-core --external ai-sdk-provider-claude-code --external @faker-js/faker src/cli.ts src/daemon.ts && bun run scripts/add-shebang.ts",
    "jl-e2e": "bun run src/cli.ts",
    "typecheck": "bun x tsc --noEmit -p ../../tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@ai-sdk/provider": "4.0.21",
    "@ai-sdk/xai": "5.0.14",
    "@e2e-dev/web": "0.11.2",
    "@faker-js/faker": "10.6.0",
    "@jittle-lamp/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.127",
    "e2e": "0.16.0",
    "fflate": "0.8.3",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "ai-sdk-provider-claude-code": "4.3.3"
  }
}
