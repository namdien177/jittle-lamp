# Copy to .env.e2e (gitignored) or point --env-file at ~/.config/jittle-lamp/e2e/<env>.env
JL_ENV_NAME=pcf-uat
JL_ENV_BASE_URL=https://uat.pcf.sv.littlelives.com
JL_VAR_PARENT_URL=https://parent.uat.pcf.sv.littlelives.com
JL_VAR_OTP_CODE=
JL_CRED_PCF_HQ_ADMIN_USERNAME=adminmanager@littlelives.com
JL_CRED_PCF_HQ_ADMIN_PASSWORD=

# model (BYOK, AI SDK ids). The id prefix picks the provider; set the key of every provider that
# JL_MODEL and JL_JUDGE_MODEL use. See onboarding-qa.md "Choosing a model provider".
# OpenRouter (model ids as listed at https://openrouter.ai/api/v1/models):
OPENROUTER_API_KEY=
JL_MODEL=openrouter/anthropic/claude-sonnet-5-5
JL_JUDGE_MODEL=openrouter/openai/gpt-5
# Or any OpenAI-compatible endpoint (Groq, Together, DeepSeek, Fireworks, vLLM, Ollama, LiteLLM):
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=
# JL_MODEL=openai-compatible/llama-3.3-70b
# Or a direct provider: OPENAI_API_KEY (openai/…), ANTHROPIC_API_KEY (anthropic/…),
# GOOGLE_GENERATIVE_AI_API_KEY (google/…), XAI_API_KEY (xai/…), AI_GATEWAY_API_KEY (gateway/…).

# runner
JL_CACHE_MODE=read-write
JL_API_TOKEN=            # jl_api_ automation token for evidence upload (optional)
