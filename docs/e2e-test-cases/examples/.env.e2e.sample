# Copy to .env.e2e (gitignored) or point --env-file at ~/.config/jittle-lamp/e2e/<env>.env
JL_ENV_NAME=pcf-uat
JL_ENV_BASE_URL=https://uat.pcf.sv.littlelives.com
JL_VAR_PARENT_URL=https://parent.uat.pcf.sv.littlelives.com
JL_VAR_OTP_CODE=
JL_CRED_PCF_HQ_ADMIN_USERNAME=adminmanager@littlelives.com
JL_CRED_PCF_HQ_ADMIN_PASSWORD=

# model (BYOK, AI SDK ids)
ANTHROPIC_API_KEY=
JL_MODEL=anthropic/claude-opus-5-5
JL_JUDGE_MODEL=anthropic/claude-sonnet-5-5

# runner
JL_CACHE_MODE=read-write
JL_API_TOKEN=            # jl_api_ automation token for evidence upload (optional)
