# ============================================================================
# Jittle Lamp shared local development defaults
# Copy to .env at the repository root. Desktop and evidence-web build scripts
# read this file; backend reads process.env when started.
# ============================================================================

# ----------------------------------------------------------------------------
# Backend API: apps/backend
# ----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_VERSION=0.1.3

# Required in production. Any high-entropy string with at least 24 characters.
APP_SECRET=replace-with-at-least-24-characters

# Turso/libSQL. Use file:./local.db for local development or libsql://... for Turso.
DATABASE_URL=file:./apps/backend/local.db
TURSO_AUTH_TOKEN=

# Run Drizzle migrations automatically on backend startup when set to true.
RUN_DB_MIGRATIONS=false

# Clerk auth for backend request verification.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Alternative to CLERK_SECRET_KEY for tests/self-hosted JWT verification.
CLERK_JWT_KEY=
CLERK_AUDIENCE=

# Comma-separated browser origins allowed by Clerk/CORS in staging/production.
# Include the evidence web origin and any Clerk authorized party origins.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:4173,http://localhost:4173

# Evidence web origin used by backend CORS and by desktop-generated share links.
WEB_APP_ORIGIN=http://127.0.0.1:4173

# Public origin clients reach the backend at (see "Desktop app" section below).
# The backend also reads this to allowlist the host used when building upload
# URLs, so proxy-forwarded host headers cannot redirect authenticated uploads
# to an arbitrary host. Set this to the real public API origin in production.

# S3-compatible artifact storage. Required in production.
# For AWS S3, S3_ENDPOINT is usually blank and S3_FORCE_PATH_STYLE=false.
# For Cloudflare R2/MinIO/Tigris, set S3_ENDPOINT and often S3_FORCE_PATH_STYLE=true.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Signed read URL lifetime. The web viewer renews before expiry while open.
S3_SIGNED_URL_TTL_SECONDS=900

# Organization migration workers use durable database leases. Target origins
# are entered by an organization admin and compatibility-checked before pairing.
MIGRATION_WORKER_CONCURRENCY=1

# Optional backend logging.
LOG_LEVEL=info

# Master key for test credential secrets (AI-driven E2E test cases). Base64 of 32 random bytes;
# it wraps one data key per organisation (AES-256-GCM). Only needed when credentials are
# written or read. Generate with: openssl rand -base64 32
# Keep it out of the database backup location; losing it makes stored secrets unreadable.
JL_SECRETS_MASTER_KEY=
# Set to the old key while rotating the master key, until data keys are re-wrapped.
JL_SECRETS_MASTER_KEY_PREVIOUS=

# Outbound calls to configured URLs (webhook callbacks, GitHub/GitLab API, Slack and webhook
# notification channels) must resolve to public addresses. Comma-separated host names exempt from
# that check, e.g. a self-managed GitLab on the internal network:
JL_OUTBOUND_ALLOW_HOSTS=
# Local development only: allow http://127.0.0.1 targets.
JL_OUTBOUND_ALLOW_LOOPBACK=false

# ----------------------------------------------------------------------------
# E2E runner and CLI: packages/e2e-runner (jl-e2e, jl-e2e-runner)
# ----------------------------------------------------------------------------
# The runner reads these from its own environment. Per-target values (JL_ENV_BASE_URL,
# JL_CRED_<PROFILE>_*, JL_VAR_*) belong in an untracked .env.e2e or come from the
# organisation config on managed runs; never put them in this file.
# Backend used by `jl-e2e env pull|push|run --remote` and by the runner daemon.
JL_API_ORIGIN=http://127.0.0.1:3001
# Automation token for CLI/CI calls (Settings → Automation tokens). Leave empty locally.
JL_API_TOKEN=
# Runner pool registration token, shown once when a pool is created. Daemon only.
JL_RUNNER_TOKEN=
# Parallel runs per daemon host (1 to 50).
JL_RUNNER_CONCURRENCY=1
# Daemon work directory (default ~/.cache/jl-e2e-runner); set JL_RUNNER_KEEP_RUNS=1 to keep run dirs.
JL_RUNNER_WORK_DIR=
JL_RUNNER_KEEP_RUNS=
# Local runs without org config: provider/model ids, e.g. anthropic/claude-sonnet-5-5 or
# mock:<fixture.json> for offline tests. The judge defaults to JL_MODEL.
JL_MODEL=
JL_JUDGE_MODEL=
# Provider key for JL_MODEL on local runs (ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY,
# AI_GATEWAY_API_KEY or OPENAI_COMPATIBLE_API_KEY + OPENAI_COMPATIBLE_BASE_URL). Put it in .env.e2e,
# not here; it is treated as a secret and redacted from all output.
# Extra variable names to treat as secrets (comma separated), on top of the built-in
# PASSWORD/OTP/KEY/TOKEN/SECRET segment rule.
JL_SECRET_NAMES=
# Development only: allow the claude-code/ provider (local Claude subscription). Never in CI.
JL_ALLOW_CLAUDE_CODE=

# ----------------------------------------------------------------------------
# Desktop app: apps/desktop
# ----------------------------------------------------------------------------
# API used by the desktop renderer for auth, sync, orgs, and share links.
JITTLE_LAMP_API_ORIGIN=http://127.0.0.1:3001

# Evidence web URL used when desktop creates "Share -> Via Link".
JITTLE_LAMP_WEB_ORIGIN=http://127.0.0.1:4173

# Optional fixed output directory. When set, the in-app output folder picker is locked.
JITTLE_LAMP_OUTPUT_DIR=

# Desktop build mode; dev uses development defines, stable/canary use production defines.
JITTLE_LAMP_DESKTOP_BUILD_ENV=dev

# ----------------------------------------------------------------------------
# Evidence web app: apps/evidence-web
# ----------------------------------------------------------------------------
# Uses CLERK_PUBLISHABLE_KEY and JITTLE_LAMP_API_ORIGIN above at build time.
# Local dev server should run at WEB_APP_ORIGIN/JITTLE_LAMP_WEB_ORIGIN.

# Local no-Clerk-account dev auth. Prefer generating these values with:
# bun run dev:test-auth:setup
JITTLE_LAMP_DEV_AUTH_ENABLED=false
JITTLE_LAMP_DEV_AUTH_USER_ID=user_jl_dev
JITTLE_LAMP_DEV_AUTH_EMAIL=dev+clerk_test@jittlelamp.local
JITTLE_LAMP_DEV_AUTH_NAME=Jittle Dev
JITTLE_LAMP_DEV_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Optional Vercel Analytics / Observability shared by desktop/evidence-web builds
# ----------------------------------------------------------------------------
REACT_APP_VERCEL_OBSERVABILITY_BASEPATH=
REACT_APP_VERCEL_OBSERVABILITY_CLIENT_CONFIG=
