{
  "name": "@jittle-lamp/desktop",
  "version": "1.8.5",
  "description": "Jittle Lamp for macOS: native recorder, library and reviewer (Rust + GPUI).",
  "private": true,
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo run -p jl-app",
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --release -p jl-app",
    "test": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --workspace",
    "bundle": "./scripts/bundle.sh"
  }
}
