{
  "name": "@jittle-lamp/backend",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:js",
    "build:js": "bun build --target bun --minify-whitespace --minify-syntax --external @jittle-lamp/e2e-runner --outfile dist/index.js src/index.ts",
    "build:bin": "bun build --compile --minify-whitespace --minify-syntax --target bun --external @jittle-lamp/e2e-runner --outfile server src/index.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:js": "NODE_ENV=production bun ./dist/index.js",
    "start:bin": "./server",
    "lint": "bun x @biomejs/biome check src test",
    "lint:fix": "bun x @biomejs/biome check --write src test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:generate": "bun x drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun x drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@clerk/backend": "3.21.0",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.4",
    "@jittle-lamp/shared": "workspace:*",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.3",
    "elysia": "2.0.0-beta.19",
    "exact-mirror": "^1.2.6",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "bun-types": "^1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
