# Copy to deploy/runner/runner.env (gitignored) and fill in.
JL_API_ORIGIN=https://api.jittlelamp.example
# Registration token shown once when the pool is created (Settings → Runner pools).
# Used only by workers that have no stored credential yet; it can stay set.
JL_RUNNER_TOKEN=
JL_RUNNER_CONCURRENCY=1
# Corporate proxies or private CAs, if the targets need them:
# HTTPS_PROXY=
# NO_PROXY=
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/company.pem

# Enable only when update-runner.mjs is running on this Docker host.
JL_RUNNER_MANAGED_UPDATES=0
